# Server
PORT=5000
NODE_ENV=development

# Database — used as-is in `development`. In `production` (NODE_ENV=production),
# knexfile.js prefers DATABASE_URL if set, otherwise falls back to the
# individual DB_* vars below with NO default values (deliberately — it fails
# loudly if unset rather than silently connecting with a guessed password).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=JewelleryERP
DB_USER=admin
DB_PASSWORD=securepass
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true   # only for hosted Postgres providers (RDS, Supabase, etc.) —
#               # leave unset for a local/on-prem Postgres install

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional - falls back gracefully)
REDIS_URL=redis://localhost:6379

# Client URLs (CORS)
CLIENT_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:19006

# REQUIRED for production — the real, public HTTPS domain this server is
# reachable at. Used to build the per-tenant Razorpay webhook URL shown in
# Super Admin → Tenant → Payment Gateway (routes/superAdmin.js). Left unset,
# it falls back to whatever host the request came in on, which shows
# "localhost" (or an internal address) instead of a real webhook URL Razorpay
# can actually call.
# PUBLIC_SERVER_URL=https://api.yourdomain.com

# Super Admin credentials (used in seed)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@2026

# Optional — enables AI-assisted invoice/tag image analysis in Invoice
# Studio (routes/invoiceStudio.js). Without it, that feature falls back to
# a default template rather than failing.
# GOOGLE_VISION_API_KEY=

# Optional — override default filesystem paths, used by the packaged
# desktop build (Electron sets UPLOADS_DIR to a writable per-user location).
# Leave unset for a normal server deployment.
# CLIENT_DIST_DIR=
# UPLOADS_DIR=

# NOT needed here: Razorpay Merchant Key/Secret/Webhook Secret are configured
# PER TENANT via Super Admin → Tenant → Payment Gateway (stored in
# tbl_payment_gateway_config), not as global env vars. RAZORPAY_KEY_ID/
# RAZORPAY_KEY_SECRET and the PHONEPE_* vars some old code still references
# belong only to routes/payments.js — a dead, disabled duplicate payment
# implementation (see its mount comment in index.js) — do not set these.
