# Server
PORT=5001
NODE_ENV=production

# Database — point this at PostgreSQL on THIS machine (must be installed separately)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=JewelleryERP
DB_USER=admin
DB_PASSWORD=securepass

# JWT — replaced with random values on first launch, do not need editing
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional - falls back gracefully)
REDIS_URL=redis://localhost:6379

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Super Admin credentials (used in seed)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@2026
